-- generated by tools/content-editor (Gen 3).
return function(mod)
  if mod.generation ~= 3 then return end
  do
    local events=mod.events
    local rawOn=events.on
    local ready={}
    events.on=function(self,name,callback,priority)
      if name=="game.ready" and type(callback)=="function" then
        ready[#ready+1]={callback=callback,priority=priority or 0,order=#ready}
      end
      return rawOn(self,name,callback,priority)
    end
    rawOn(events,"mods.loaded",function(payload)
      local data=type(payload)=="table" and payload.data
      if not (type(data)=="table" and data.game3Maps) then return end
      table.sort(ready,function(a,b)
        if a.priority~=b.priority then return a.priority>b.priority end
        return a.order<b.order
      end)
      local ctx={game={data=data},editor=true}
      for _,handler in ipairs(ready) do pcall(handler.callback,ctx) end
    end,-100)
  end
do
  local schema=require("src.mods.Schemas")
  local field=schema.REGISTRIES.pokemon.gen3Fields.index
  local expanded=schema.f.int(1,65535)
  -- Change the shared descriptor, including cached Gen 3 schema shapes.
  field.inner=expanded;field.desc=expanded.desc
end

do local authoredMaps={}; local authoredVersion="sapphire"
  do
    local MapIds = require("src.core.game3.map_ids")
    local original = MapIds.isGame3Map
    MapIds.isGame3Map = function(id, gameId)
      if original(id, gameId) then return true end
      local version = gameId or require("src.core.GameVersion").get()
      return version == authoredVersion and authoredMaps[id] == true
        and mod.content.maps:get(id) ~= nil
    end
  end

end
